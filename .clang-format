# General Options
BasedOnStyle: Google
ColumnLimit: 140
Language: Cpp
Standard: c++20
PointerAlignment: Left
DerivePointerAlignment: false
TabWidth: 4
UseTab: Never

# Whitespace Settings
MaxEmptyLinesToKeep: 2
KeepEmptyLines:
  AtStartOfBlock: true
EmptyLineBeforeAccessModifier: Always
EmptyLineAfterAccessModifier: Always
SeparateDefinitionBlocks: Always
# clang-format 20+ can additionally insert blank lines inside namespaces:
# WrapNamespaceBodyWithEmptyLines: Always
# Class-body padding has no automatic insertion option. Version 19 removes
# blank lines before class closing braces even when supplied manually.
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 2
SpacesInAngles: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Sorting
SortIncludes: true
SortUsingDeclarations: true

# Single/Multiline Collapse/Expansion
AllowAllConstructorInitializersOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
AlwaysBreakTemplateDeclarations: true
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: Empty
AllowShortLoopsOnASingleLine: false
BinPackArguments: false
BinPackParameters: false
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeColon
ConstructorInitializerAllOnOneLineOrOnePerLine: true
