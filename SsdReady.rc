END

IDD_DIALOG_LOG DIALOGEX 0, 0, 309, 244
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Log Viewer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,119,216,70,20
    LISTBOX         IDC_LIST_LOG,8,28,292,172,NOT LBS_NOTIFY | LBS_OWNERDRAWVARIABLE | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | LBS_DISABLENOSCROLL | LBS_NOSEL | NOT WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Program log:",IDC_STATIC_LOG_LABEL,8,8,135,14,SS_CENTERIMAGE
END


