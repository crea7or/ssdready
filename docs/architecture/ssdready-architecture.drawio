        <mxCell id="core" value="&lt;b&gt;ApplicationCore / application services&lt;/b&gt;&lt;br&gt;&lt;br&gt;Owns manager, settings and UI references&lt;br&gt;Driver service start / stop through SCM&lt;br&gt;Core() and Registry() global access" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#45658B;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
