        <mxCell id="treeui" value="&lt;b&gt;MonitoringTreeCtrl / SortableListCtrl&lt;/b&gt;&lt;br&gt;&lt;br&gt;Model-backed display callbacks&lt;br&gt;Populate children when folders expand&lt;br&gt;PostMessage + redraw batching" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#45658B;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1160" y="195" width="470" height="155" as="geometry" />
        </mxCell>
        <mxCell id="rx" value="&lt;b&gt;RetrieveLogRecords thread&lt;/b&gt;&lt;br&gt;&lt;br&gt;Poll \SsdSpyPort; parse driver records&lt;br&gt;Filter write events; resolve PID names&lt;br&gt;Create owning PendingWriteEvent&lt;br&gt;Enqueue; optional raw debug logging" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="515" width="390" height="175" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Owning batch queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;deque of unique_ptr&amp;lt;EventBatch&amp;gt;&lt;br&gt;Batch: vector of unique_ptr events&lt;br&gt;Producer push_back / consumer pop_front&lt;br&gt;FIFO; mutex + condition variable" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFA;strokeColor=#796094;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="600" y="515" width="405" height="175" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;ProcessLogRecords thread&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resolve volume path and file node&lt;br&gt;Optional process aggregation&lt;br&gt;Update file / ancestor / global totals&lt;br&gt;Delete consumed event" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1150" y="515" width="480" height="175" as="geometry" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;Shared monitoring model&lt;/b&gt;&lt;br&gt;&lt;br&gt;File/folder tree + process statistics&lt;br&gt;Path cache, PID cache, drive list" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFA;strokeColor=#796094;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="600" y="750" width="405" height="115" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="&lt;b&gt;LoadMonitoredItems / SaveMonitoredItems&lt;/b&gt;&lt;br&gt;&lt;br&gt;BufferedFile → File → Win32 I/O&lt;br&gt;Version 1 snapshot; recursive tree format" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2DE;strokeColor=#A27433;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
