  <diagram id="ssdready-2" name="02 · Write-event processing">
    <mxGraphModel dx="2490" dy="1590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2490" pageHeight="1590" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="02 · Write-event processing" style="text;html=1;align=left;fontSize=32;fontStyle=1;fontColor=#162B40;" vertex="1" parent="1">
          <mxGeometry x="35" y="25" width="2420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two worker threads • full accepted-event path • branches, ownership and hot-path behavior" style="text;html=1;align=left;fontSize=18;fontColor=#526478;" vertex="1" parent="1">
          <mxGeometry x="35" y="83" width="2420" height="35" as="geometry" />
        </mxCell>
        <mxCell id="band-0" value="Producer thread — MiniSpyManager::RetrieveLogRecords" style="rounded=1;arcSize=3;html=1;fillColor=#F5F7FA;strokeColor=#DCE3EB;align=left;verticalAlign=top;spacingTop=16;spacingLeft=20;fontSize=21;fontStyle=1;fontColor=#344C63;" vertex="1" parent="1">
          <mxGeometry x="35" y="150" width="2420" height="430" as="geometry" />
        </mxCell>
        <mxCell id="band-1" value="Consumer thread — MiniSpyManager::ProcessLogRecords" style="rounded=1;arcSize=3;html=1;fillColor=#F5F7FA;strokeColor=#DCE3EB;align=left;verticalAlign=top;spacingTop=16;spacingLeft=20;fontSize=21;fontStyle=1;fontColor=#344C63;" vertex="1" parent="1">
          <mxGeometry x="35" y="660" width="2420" height="440" as="geometry" />
        </mxCell>
        <mxCell id="poll" value="&lt;b&gt;1 · Poll driver port&lt;/b&gt;&lt;br&gt;&lt;br&gt;FilterSendMessage(GetMiniSpyLog)&lt;br&gt;256 KiB receive buffer&lt;br&gt;No records / error: Sleep(POLL_INTERVAL)&lt;br&gt;Invalid handle or &amp;gt;100 unexpected errors: initiate cleanup" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="65" y="225" width="355" height="305" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;2 · Validate record framing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check header, record length and batch bounds&lt;br&gt;Walk LOG_RECORD.Length entries&lt;br&gt;FILETAG: TranslateFileTag()&lt;br&gt;Untranslatable tags are skipped&lt;br&gt;Malformed record stops batch parsing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="465" y="225" width="355" height="305" as="geometry" />
        </mxCell>
        <mxCell id="filter" value="&lt;b&gt;3 · Select accepted writes&lt;/b&gt;&lt;br&gt;&lt;br&gt;GetLogStatus() must be true&lt;br&gt;CallbackMajorId == IRP_MJ_WRITE&lt;br&gt;Accept when IRP_INPUT_OPERATION is clear OR path contains &amp;quot;$&amp;quot;&lt;br&gt;Status is received but not tested here&lt;br&gt;Other records are skipped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="865" y="225" width="355" height="305" as="geometry" />
        </mxCell>
        <mxCell id="event" value="&lt;b&gt;4 · Build pending event&lt;/b&gt;&lt;br&gt;&lt;br&gt;AddTotalReaded(ReadDataLength)&lt;br&gt;new PendingWriteEvent&lt;br&gt;PID: DWORD; write size: DWORD64&lt;br&gt;Filename copied unless DoNotLogFiles&lt;br&gt;Read total is updated outside model lock" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1265" y="225" width="355" height="305" as="geometry" />
        </mxCell>
        <mxCell id="pid" value="&lt;b&gt;5 · Optional process name&lt;/b&gt;&lt;br&gt;&lt;br&gt;CollectProcessesInformation enabled?&lt;br&gt;GetProcessNameById(PID)&lt;br&gt;Linear runtimeProcess cache lookup&lt;br&gt;Cache miss: process/module APIs; fallback snapshot enumeration&lt;br&gt;Uses processed-model mutex" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1665" y="225" width="355" height="305" as="geometry" />
        </mxCell>
        <mxCell id="enqueue" value="&lt;b&gt;6 · Queue and debug log&lt;/b&gt;&lt;br&gt;&lt;br&gt;LockUnprocessedArrayAccess()&lt;br&gt;Add(event): queue takes ownership&lt;br&gt;If SSDREADY_UNPROCESSED_LOG_WRITE: SaveToLog() while holding lock&lt;br&gt;Raw File writes; six calls for nonempty names&lt;br&gt;Release queue mutex" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFA;strokeColor=#796094;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="2065" y="225" width="355" height="305" as="geometry" />
        </mxCell>
        <mxCell id="pop" value="&lt;b&gt;7 · Take one batch&lt;/b&gt;&lt;br&gt;&lt;br&gt;GetNextBatchToProcess(): lock queue&lt;br&gt;Move front batch, pop_front, unlock&lt;br&gt;Ownership transfers to consumer&lt;br&gt;Empty: wait on condition variable&lt;br&gt;Drain accepted batches during shutdown" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="65" y="735" width="355" height="315" as="geometry" />
        </mxCell>
        <mxCell id="volume" value="&lt;b&gt;8 · Resolve volume path&lt;/b&gt;&lt;br&gt;&lt;br&gt;DoNotLogFiles: skip path conversion&lt;br&gt;Otherwise VolumeToDriveName()&lt;br&gt;Match volume prefix against drive list&lt;br&gt;Uses drives mutex&lt;br&gt;Failure: skip file/global-byte updates; event is still counted and deleted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="465" y="735" width="355" height="315" as="geometry" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b&gt;9 · Resolve file/folder node&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hold processed-model mutex&lt;br&gt;Skip this stage in totals-only mode&lt;br&gt;Full-path unordered_map cache lookup&lt;br&gt;Miss: GetFileAttributes + split path&lt;br&gt;Recursive child-name scan; create nodes&lt;br&gt;Cache path → tree pointer&lt;br&gt;New nodes PostMessage to UI tree" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="865" y="735" width="355" height="315" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;10 · Optional attribution&lt;/b&gt;&lt;br&gt;&lt;br&gt;ResolveProcess(): match process basename, case insensitive&lt;br&gt;Create CEProcess if absent&lt;br&gt;Add bytes to global process total&lt;br&gt;SetProcessWrite(): find/create node link by process_index&lt;br&gt;Skip when collection is disabled" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1265" y="735" width="355" height="315" as="geometry" />
        </mxCell>
        <mxCell id="aggregate" value="&lt;b&gt;11 · Update statistics&lt;/b&gt;&lt;br&gt;&lt;br&gt;TreeItem::AddWrite(bytes)&lt;br&gt;Own byte total + per-write 4 KiB rounding&lt;br&gt;Propagate cached totals to ancestors&lt;br&gt;Mark descriptions stale&lt;br&gt;AddTotalWritten(): global normal and rounded totals&lt;br&gt;Release processed-model mutex" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1665" y="735" width="355" height="315" as="geometry" />
        </mxCell>
        <mxCell id="release" value="&lt;b&gt;12 · Finalize batch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Count each processed operation&lt;br&gt;Owned events destroyed with the batch&lt;br&gt;Return to GetNextBatchToProcess()&lt;br&gt;GUI insertion stays on the UI thread" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F4EF;strokeColor=#397D65;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="2065" y="735" width="355" height="315" as="geometry" />
        </mxCell>
        <mxCell id="payload" value="&lt;b&gt;Event payload and lifetime&lt;/b&gt;&lt;br&gt;&lt;br&gt;PendingWriteEvent: CString filename + CString process name + DWORD PID + DWORD64 write size.&lt;br&gt;x64: object 32 B; queue slot 8 B; string buffers extra. Process-name CString storage may be shared.&lt;br&gt;Normal processing retains only aggregates. No timestamp, offset, file content or per-file event count is stored.&lt;br&gt;PID is used for name resolution / debug output; persisted process identity is a name-based index." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2ECFA;strokeColor=#796094;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="65" y="1170" width="705" height="300" as="geometry" />
        </mxCell>
        <mxCell id="branches" value="&lt;b&gt;Configuration branches&lt;/b&gt;&lt;br&gt;&lt;br&gt;DoNotLogFiles: skip filenames, volume conversion, tree nodes and process totals; retain global write statistics.&lt;br&gt;CollectProcessesInformation: controls name resolution and per-process attribution.&lt;br&gt;GetLogStatus(): start/pause admission of driver records.&lt;br&gt;Unprocessed-log macros are currently enabled in pch.h; the raw log path is hardcoded." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF9E9;strokeColor=#A89053;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="875" y="1170" width="705" height="300" as="geometry" />
        </mxCell>
        <mxCell id="costs" value="&lt;b&gt;Current processing boundaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each accepted write allocates an event and usually a full filename buffer.&lt;br&gt;PID/global-process/per-file process lookups use linear scans; first-seen files scan folder children.&lt;br&gt;Queue has no explicit capacity limit or backpressure. Full paths stay cached until ClearData().&lt;br&gt;Source: mini_spy_manager.cpp, pending_write_event.h, tree_item.cpp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF9E9;strokeColor=#A89053;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1685" y="1170" width="705" height="300" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526478;fontFamily=Segoe UI;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="poll" target="parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526478;fontFamily=Segoe UI;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="parse" target="filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526478;fontFamily=Segoe UI;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="filter" target="event">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#526478;fontFamily=Segoe UI;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="event" target="pid">
