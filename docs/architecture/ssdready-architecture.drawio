        <mxCell id="os" value="&lt;b&gt;Windows / registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;Process APIs, volumes, SCM, files&lt;br&gt;SettingsRegistry → InterfaceSettings&lt;br&gt;RuntimeSettings → data paths" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF1F5;strokeColor=#667789;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="600" y="1015" width="405" height="145" as="geometry" />
