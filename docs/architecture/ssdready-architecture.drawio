        <mxCell id="disk" value="&lt;b&gt;Monitored.Files + diagnostic log&lt;/b&gt;&lt;br&gt;&lt;br&gt;%APPDATA%\CEZEO software\SsdReady&lt;br&gt;Aggregates: no per-event history&lt;br&gt;Debug: g:\ssdready-unprocessed.bin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2DE;strokeColor=#A27433;strokeWidth=1.5;fontColor=#20354A;fontFamily=Segoe UI;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
