        <mxCell id="footer" value="Current source: application_core.*, mini_spy_manager.*, tree_item.*, folder_tree_item.*, file_tree_item.h, BufferedFile.*, File.*, minispy.h, MainDialog / MonitoringTreeCtrl. Diagram is descriptive, not a proposed redesign." style="text;html=1;align=left;fontSize=14;fontColor=#667789;" vertex="1" parent="1">
